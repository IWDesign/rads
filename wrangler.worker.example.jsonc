{
  "name": "rads",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "ENQUIRIES_DB",
      "database_name": "rads-enquiries",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
